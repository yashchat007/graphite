# Shared secret — same value in Vercel env and the app access-key screen (header: x-app-secret)
APP_SECRET=your-long-random-secret

# Upstash Redis (Vercel KV uses the KV_* names; Upstash dashboard uses UPSTASH_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — private file storage (client uploads; no list() on load)
BLOB_READ_WRITE_TOKEN=

# Vercel Cron invokes GET /api/files/cleanup with Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-cron-secret
